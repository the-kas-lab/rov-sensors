<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rov_sonoptix</name>
  <version>0.0.0</version>
  <description>ROS 2 driver, fan display and mock for the Sonoptix ECHO multibeam imaging sonar</description>
  <maintainer email="gesemgudino@gmail.com">Gesem Mejia</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rov_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>       <!-- sonoptix_fan_node colormaps -->
  <exec_depend>python3-gi</exec_depend>
  <exec_depend>gstreamer1.0-plugins-good</exec_depend>  <!-- rtspsrc, rtph264depay -->
  <exec_depend>gstreamer1.0-plugins-bad</exec_depend>   <!-- h264parse -->
  <exec_depend>gstreamer1.0-libav</exec_depend>         <!-- avdec_h264 -->
  <!-- The mock (use_mock:=true) also needs fastapi/uvicorn/pydantic (rov-sensors/requirements.txt)
       and GStreamer's RTSP server and x264 encoder with Python bindings; without them it serves
       only the REST API. See sonoptix_mock/README.md. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
