<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rov_bringup</name>
  <version>0.0.0</version>
  <description>Launches all ROV sensors (sonar + camera) with one Foxglove bridge and a combined layout</description>
  <maintainer email="gesemgudino@gmail.com">Gesem Mejia</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rov_omniscan</exec_depend>
  <exec_depend>rov_camera</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
