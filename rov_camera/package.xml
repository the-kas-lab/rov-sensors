<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rov_camera</name>
  <version>0.0.0</version>
  <description>ROS 2 node that receives the BlueROV camera stream from BlueOS (RTSP or RTP/UDP H.264)</description>
  <maintainer email="gesemgudino@gmail.com">Gesem Mejia</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>python3-gi</exec_depend>
  <exec_depend>gstreamer1.0-plugins-good</exec_depend>  <!-- rtspsrc, udpsrc, rtph264depay, jpegenc -->
  <exec_depend>gstreamer1.0-plugins-bad</exec_depend>   <!-- h264parse -->
  <exec_depend>gstreamer1.0-libav</exec_depend>         <!-- avdec_h264 -->
  <!-- use_mock:=true additionally needs ffmpeg (with libx264) to stream the webcam. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
